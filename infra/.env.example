# Runtime
PDR_ENV=dev

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TEXT_CHARS=8000
VLM_ENABLED=false
OLLAMA_VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT_SECONDS=90

# Postgres
POSTGRES_DB=pdr
POSTGRES_USER=pdr
POSTGRES_PASSWORD=pdr_dev_only
DATABASE_URL=postgresql://pdr:pdr_dev_only@db:5432/pdr
