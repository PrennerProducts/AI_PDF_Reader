# Runtime
PDR_ENV=dev

# Postgres
POSTGRES_DB=pdr
POSTGRES_USER=pdr
POSTGRES_PASSWORD=pdr_dev_only
DATABASE_URL=postgresql://pdr:pdr_dev_only@db:5432/pdr

# App Login
APP_AUTH_ENABLED=false
APP_BOOTSTRAP_USERNAME=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_DISPLAY_NAME=
APP_SESSION_TTL_HOURS=12

# VenDoc MSSQL (live write disabled until CIBEX access is available)
VENDOC_MSSQL_ENABLED=false
VENDOC_MSSQL_HOST=
VENDOC_MSSQL_PORT=1433
VENDOC_MSSQL_DATABASE=SRTemp
VENDOC_MSSQL_USER=
VENDOC_MSSQL_PASSWORD=
VENDOC_MSSQL_ENCRYPT=true
VENDOC_MSSQL_TRUST_SERVER_CERTIFICATE=false
VENDOC_MSSQL_TIMEOUT_SECONDS=30
VENDOC_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
